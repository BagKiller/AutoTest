+        /// <summary>覆盖度校验的容差（%）：边界按 0.1 取整，留 0.05 免得把正常的取整差判成断档。</summary>
+        private const double CoverageTolerancePercent = 0.05;
+
+        /// <summary>
+        /// 保存后校验该膜系表：是否覆盖到标定量程上限、段与段之间是否断档。
+        /// 只提示不阻止保存——操作员可能先存半张表再补测；运行期缺口会走到 default 回退并给警告。
+        /// </summary>
+        private void ValidateFilmTableCoverage(IReadOnlyList<LaserBpsRuleSaveEntry> entries,
+                                               IReadOnlyList<BPSCaliGraph> graphs,
+                                               ThroughputType throughput,
+                                               string film)
+        {
+            if (entries.Count == 0)
+            {
+                return;
+            }
+
+            var ranges = entries
+                .Select(e => (e.MinLaserPowerPercent, e.MaxLaserPowerPercent))
+                .OrderByDescending(r => r.MaxLaserPowerPercent)
+                .ToList();
+
+            var problems = new List<string>();
+            var problemsEnglish = new List<string>();
+            double expectedTop = graphs.Count > 0 ? graphs.Max(g => g.MaxLaserPowerPercent) : 0;
+            if (expectedTop > 0 && ranges[0].MaxLaserPowerPercent < expectedTop - CoverageTolerancePercent)
+            {
+                problems.Add(string.Format(Resources.BpsFilmCoverageTopFmt, ranges[0].MaxLaserPowerPercent, expectedTop));
+                problemsEnglish.Add($"top boundary {ranges[0].MaxLaserPowerPercent:F2} < calibrated range {expectedTop:F2}");
+            }
+
+            for (int i = 0; i < ranges.Count - 1; i++)
+            {
+                double lowerMax = ranges[i + 1].MaxLaserPowerPercent;
+                double upperMin = ranges[i].MinLaserPowerPercent;
+                if (upperMin - lowerMax > CoverageTolerancePercent)
+                {
+                    problems.Add(string.Format(Resources.BpsFilmCoverageGapFmt, lowerMax, upperMin));
+                    problemsEnglish.Add($"gap ({lowerMax:F2}, {upperMin:F2}]");
+                }
+            }
+
+            if (problems.Count == 0)
+            {
+                return;
+            }
+
+            // 日志用英文（仓库规范），弹窗用中文；两者不共用同一字符串，避免耦合
+            _logger.Warning(_compName,
+                $"BPS film table coverage incomplete: film={film}, throughput={throughput}, problems={string.Join("; ", problemsEnglish)}. Re-calibrate this film.");
+
+            string message = string.Format(Resources.BpsFilmCoverageMessageFmt, film, throughput, string.Join(Resources.BpsClauseSeparator, problems));
+            var dispatcher = Application.Current?.Dispatcher;
+            if (dispatcher == null || dispatcher.CheckAccess())
+            {
+                AddLogEntry($"[Coverage] {message}");
+            }
+            else
+            {
+                dispatcher.Invoke(() => AddLogEntry($"[Coverage] {message}"));
+            }
+
+            MessageHelper.ShowWarningMessage("BPS Diagnostics", message);
+        }
