diff --git a/Vega.Data.Recipes/Helper/LaserBpsTableProvider.cs b/Vega.Data.Recipes/Helper/LaserBpsTableProvider.cs
new file mode 100644
index 00000000..99b1b67f
--- /dev/null
+++ b/Vega.Data.Recipes/Helper/LaserBpsTableProvider.cs
@@ -0,0 +1,25 @@
+﻿// Copyright (c) Shanghai Vega Technology Co., Ltd. All rights reserved.
+
+using Vega.Data.Commons;
+using Vega.Utility.Helper;
+
+namespace Vega.Data.Recipes;
+
+/// <summary>
+/// 加载 BPS 规则的两张表：default（原 LaserBpsODConfig.json）+ 膜系（LaserBpsODFilmConfig.json）。
+/// 膜系文件不存在时视为空表，不报错；纯读取，不做缓存。
+/// </summary>
+public static class LaserBpsTableProvider
+{
+    public static Laser_BpsTables Load()
+    {
+        var tables = new Laser_BpsTables
+        {
+            Default = LoadConfigManager.LoadConfig<Laser_BpsConfig>(LaserBpsConfigPaths.FileName),
+            Films = LoadConfigManager.ConfigExists(LaserBpsConfigPaths.FilmFileName)
+                ? LoadConfigManager.LoadConfig<Laser_BpsConfig>(LaserBpsConfigPaths.FilmFileName)
+                : new Laser_BpsConfig(),
+        };
+        return tables;
