+    private void ReloadBpsTables()
+    {
+        try
+        {
+            _bpsTables = LaserBpsTableProvider.Load();
+        }
+        catch
+        {
+            _bpsTables = null;
+        }
+
+        // 配方引用的膜系在本机文件里已不存在（诊断页删除/配方拷自他机）：重置为 default，
+        // 不在下拉里挂幽灵名字。运行期"查不到回退 default"的兜底机制不变。
+        var current = Laser_BpsConfig.NormalizeFilmName(BpsFilmTable);
+        if (_bpsTables != null && !Laser_BpsConfig.IsDefaultFilm(current) && !_bpsTables.HasFilmTable(current))
+        {
+            BpsFilmTable = Laser_BpsConfig.DefaultFilmName;
+            current = Laser_BpsConfig.DefaultFilmName;
+        }
+
+        IReadOnlyList<string> names = _bpsTables?.GetFilmTableNames() ?? new[] { Laser_BpsConfig.DefaultFilmName };
