@@ -0,0 +1,48 @@
+// Copyright (c) Shanghai Vega Technology Co., Ltd. All rights reserved.
+
+using Galaxy.Platform.Patterns.WPF;
+using Vega.Utility.Common.Properties;
+using System.Windows;
+
+namespace Vega.UI.Diagnostics.DeviceDiagnostics.BPSDiagnostics
+{
+    /// <summary>
+    /// 本页专用的小输入窗：新建/重命名膜系用。风格对齐 BPSDiagnosticsPowerVerifyWindow
+    /// （CenterOwner + Owner = 主窗 + ShowDialog），避免 VisualBasic InputBox 的异构弹窗。
+    /// </summary>
+    public partial class BPSFilmNameInputDialog : Window
+    {
+        private readonly string _title;
+        private readonly string _message;
+
+        public string? InputValue { get; private set; }
+
+        public BPSFilmNameInputDialog(string title, string message, string defaultValue = "")
+        {
+            _title = title;
+            _message = message;
+            InitializeComponent();
+            Title = title;
+            MessageText.Text = message;
+            InputTextBox.Text = defaultValue;
+            Loaded += (_, _) =>
+            {
+                InputTextBox.Focus();
+                InputTextBox.SelectAll();
+            };
+        }
+
+        private void OkButton_Click(object sender, RoutedEventArgs e)
+        {
+            var value = InputTextBox.Text?.Trim();
+            if (string.IsNullOrEmpty(value))
+            {
+                MessageHelper.ShowWarningMessage(_title, Vega.Utility.Common.Properties.Resources.BpsFilmNameEmpty);
+                return;
+            }
+
+            InputValue = value;
+            DialogResult = true;
+        }
+    }
+}
