+    private void RecipeComboBox_GotFocus(object sender, RoutedEventArgs e)
+    {
+        if (sender is not ComboBox combo) return;
+
+        // 进入输入区即展开下拉：StaysOpenOnEdit 只保证编辑时"保持"打开，不会自动打开，
+        // 不主动展开的话输入过滤词时看不到过滤结果，上下键也无从选择
+        if (!combo.IsDropDownOpen)
+        {
+            combo.IsDropDownOpen = true;
+        }
+        // 全选文本：再次点击输入时直接键入新过滤词，避免在"选中回显的完整路径"后追加字符导致 0 命中。
+        // WPF ComboBox 无 SelectAll，可编辑模式下焦点在内部编辑 TextBox 上，经路由事件的 OriginalSource 取之
+        if (e.OriginalSource is TextBox textBox)
+        {
+            // 上下键的键盘事件会被上层（应用级键盘处理/TextBox 插入符命令）在到达普通订阅前标记已处理
+            // （本应用中 ComboBox 层订阅收不到），须以 handledEventsToo:true 挂到内部 TextBox 的
+            // PreviewKeyDown 上才能可靠接管；先移除防重复订阅
+            textBox.RemoveHandler(TextBox.PreviewKeyDownEvent, new KeyEventHandler(RecipeTextBox_PreviewKeyDown));
+            textBox.AddHandler(TextBox.PreviewKeyDownEvent, new KeyEventHandler(RecipeTextBox_PreviewKeyDown), true);
+            textBox.SelectAll();
+        }
+    }
+
+    private void RecipeTextBox_PreviewKeyDown(object? sender, KeyEventArgs e)
+    {
+        // Enter 选中后下拉已关而焦点仍留在输入框：继续编辑（退格/删除/键入）时重新展开过滤列表，
+        // 此时 GotFocus 不会触发（焦点未离开）
+        if (sender is TextBox tb && tb.TemplatedParent is ComboBox combo && !combo.IsDropDownOpen && IsEditingKey(e.Key))
+        {
+            combo.IsDropDownOpen = true;
+        }
+        if (NavigateFilteredRecipes(e.Key))
+        {
+            e.Handled = true;
+        }
+    }
+
+    private static bool IsEditingKey(Key key)
+        => key is Key.Back or Key.Delete or Key.Space
+           or (>= Key.D0 and <= Key.Z)
+           or (>= Key.NumPad0 and <= Key.NumPad9)
+           or (>= Key.Oem1 and <= Key.OemBackslash);
+
+    private bool NavigateFilteredRecipes(Key key)
+    {
+        // 接管上下键导航：原生导航会把高亮项的完整路径写回 Text，被当作过滤词后 Refresh 的 Reset
+        // 会打断高亮并使列表塌缩成一项，导致键盘无法选择——改为直接在过滤后的列表里移动选中项。
+        // 选中项因"恒保留"规则钉在视图里但与搜索词不匹配时（如搜索 New 而选中 TestRecipe），
+        // 不作为导航锚点：↓ 从首个匹配项开始，且该钉住项不参与导航
+        if (key is not (Key.Down or Key.Up)) return false;
+        if (DataContext is not LotViewModel vm || vm.AvailableRecipesView is not { } view) return false;
+
+        var search = vm.RecipeSearchText;
+        bool selectedMatchesSearch = vm.SelectedRecipe != null
+            && (string.IsNullOrWhiteSpace(search)
+                || vm.SelectedRecipe.RecipePath.Contains(search, StringComparison.OrdinalIgnoreCase));
+        var list = view.OfType<SimpleRecipe>()
+            .Where(r => selectedMatchesSearch || !ReferenceEquals(r, vm.SelectedRecipe))
+            .ToList();
+        if (list.Count == 0) return false;
+
+        int index = selectedMatchesSearch ? list.IndexOf(vm.SelectedRecipe!) : -1;
+        int next = key == Key.Down ? index + 1 : index - 1;
+        if (next < 0 || next >= list.Count) return false;
+
+        vm.SelectedRecipe = list[next];
+        return true;
+    }
+
+    private void RecipeComboBox_PreviewMouseLeftButtonDown(object sender, MouseButtonEventArgs e)
+    {
+        // 焦点仍在输入框、下拉却被点击空白关闭（light-dismiss）后，再点击输入区需重新展开——此时
+        // GotFocus 不会触发。只响应编辑区（PART_EditableTextBox）内的点击，避免抢在下拉箭头
+        // ToggleButton 之前展开、随后又被 Toggle 切换关闭
+        if (sender is not ComboBox combo || combo.IsDropDownOpen) return;
+        if (combo.Template?.FindName("PART_EditableTextBox", combo) is not TextBox editBox) return;
+        if (e.OriginalSource is not DependencyObject source || !IsDescendantOf(source, editBox)) return;
+
+        combo.IsDropDownOpen = true;
+    }
+
+    private static bool IsDescendantOf(DependencyObject node, DependencyObject ancestor)
+    {
+        while (node is not null)
+        {
+            if (ReferenceEquals(node, ancestor)) return true;
+            node = VisualTreeHelper.GetParent(node);
+        }
+        return false;
+    }
+
+    private void RecipeComboBox_DropDownClosed(object? sender, EventArgs e)
+    {
+        if (sender is not ComboBox combo || DataContext is not LotViewModel vm) return;
+
+        // 点击空白/Esc 关闭下拉时，键盘焦点可能仍留在输入框（LostFocus 不会触发），此处兜底回显实际选中项
+        // SetCurrentValue：直接对 Text 赋本地值会移除 XAML 的 RecipeSearchText 绑定表达式
+        if (!string.Equals(combo.Text, vm.SelectedRecipe?.RecipePath, StringComparison.OrdinalIgnoreCase))
+        {
+            combo.SetCurrentValue(ComboBox.TextProperty, vm.SelectedRecipe?.RecipePath ?? string.Empty);
+        }
+        // Enter/点击选中后，可编辑组合框会把编辑框文本全选高亮——取消选区、光标置末尾，呈现干净的已选状态
+        if (combo.Template?.FindName("PART_EditableTextBox", combo) is TextBox editBox && editBox.Text.Length > 0)
+        {
+            editBox.Select(editBox.Text.Length, 0);
+        }
+    }
+
+    private void RecipeComboBox_LostFocus(object sender, RoutedEventArgs e)
+    {
+        if (sender is not ComboBox combo || DataContext is not LotViewModel vm) return;
+
+        // 输入了过滤词但未选中条目时，回显实际选中项，保证显示与保存内容一致
+        if (!string.Equals(combo.Text, vm.SelectedRecipe?.RecipePath, StringComparison.OrdinalIgnoreCase))
+        {
+            combo.SetCurrentValue(ComboBox.TextProperty, vm.SelectedRecipe?.RecipePath ?? string.Empty);
+        }
+    }
 }
