index b28289b1..a034d307 100644
--- a/Vega.BL.IWaferRun/NotchChannelResolver.cs
+++ b/Vega.BL.IWaferRun/NotchChannelResolver.cs
@@ -16,6 +16,18 @@ public enum NotchDataChannelFamily
     DW,
 }
 
+/// <summary>
+/// 外→内机型（加装 Edge Detector 的 Vega100）notch 对位数据来源（机台级配置 Edge Detection/
+/// NotchDataSource，"DarkField"|"EdgeDetector"，缺省 DarkField）。
+/// DarkField = 现状暗场家族（NotchDataChannel 家族 + 入射选通道）；
+/// EdgeDetector = 第二张 NI 卡上的被动边缘检测器（逻辑通道 9999，条目 ValidOn 保证仅 ED 机型可达）。
+/// </summary>
+public enum NotchDataSourceType
+{
+    DarkField,
+    EdgeDetector,
+}
+
 /// <summary>
 /// 外→内机型（Vega100，无独立边缘激光）notch 数据源通道：家族可配置 + 按 collection 入射选型，
 /// 与配方 GetPhysicalChannels 的同族选型同规则（DN: Normal→DN_Normal/Oblique→DN_Oblique；
@@ -40,4 +52,12 @@ public static class NotchChannelResolver
     /// </summary>
     public static NotchDataChannelFamily ParseFamily(string? configured)
         => string.Equals(configured, "DN", StringComparison.OrdinalIgnoreCase) ? NotchDataChannelFamily.DN : NotchDataChannelFamily.DW;
+
+    /// <summary>
+    /// 数据来源容错解析："EdgeDetector"（忽略大小写）→ EdgeDetector；
+    /// 其余（空/未配置/"DarkField"/非法值）→ DarkField（默认=现状）。照 <see cref="ParseFamily"/> 范式。
+    /// 非法值的 Warning 由调用方承载（此处保持纯静态零依赖）。
+    /// </summary>
+    public static NotchDataSourceType ParseSource(string? configured)
+        => string.Equals(configured, "EdgeDetector", StringComparison.OrdinalIgnoreCase) ? NotchDataSourceType.EdgeDetector : NotchDataSourceType.DarkField;
 }
