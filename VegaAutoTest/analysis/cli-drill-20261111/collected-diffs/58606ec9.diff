@@ -0,0 +1,15 @@
+// Copyright (c) Shanghai Vega Technology Co., Ltd. All rights reserved.
+
+namespace Vega.PD.IDAQDevice;
+
+/// <summary>
+/// 单物理通道 edge 截断守卫（纯静态；NICardDevice 与测试项目经既有引用共享）。
+/// token 由调用方在 <c>CreateDaqTask</c> 入口快照传入，谓词本身不做环境判定。
+/// </summary>
+public static class EdgeForwardPolicy
+{
+    /// <summary>非 edge 通道 / 无 token / 未达最小采样数 → 放行转发。</summary>
+    public static bool ShouldForward(bool isEdgeChannel, bool hasEdgeDetectorToken,
+        ulong curTotalRead, ulong minSamplesCount)
+        => !isEdgeChannel || !hasEdgeDetectorToken || curTotalRead < minSamplesCount;
+}
diff --git a/Vega.UI.Diagnostics.Tests/EdgeForwardPolicyTests.cs b/Vega.UI.Diagnostics.Tests/EdgeForwardPolicyTests.cs
new file mode 100644
index 00000000..b5995e67
--- /dev/null
+++ b/Vega.UI.Diagnostics.Tests/EdgeForwardPolicyTests.cs
@@ -0,0 +1,57 @@
+// Copyright (c) Shanghai Vega Technology Co., Ltd. All rights reserved.
+
+using System.Reflection;
+using Vega.PD.IDAQDevice;
+using Vega.Utility.Helper;
+
+namespace Vega.UI.Diagnostics.Tests;
+
+/// <summary>
+/// 单物理通道 edge 截断守卫真值表（实施计划 §4.3b / 决策 10）。
+/// NICardDevice 的守卫内嵌 private ProcessBuffer（原生 buffer/XComponent 生命周期交织不可反射驱动），
+/// Sim 侧 DAQDeviceSimBase 对 edge 通道又是存量无条件截断（无 token 判断）——本真值表是 token 守卫的
+/// 唯一覆盖；真机 V200 12 寸 inline 单 9999 回归由硬件阶段补充。
+/// </summary>
+public class EdgeForwardPolicyTests
+{
+    [Theory]
+    [InlineData(false, false, 0UL, 0UL, true)]      // 非 edge 通道：恒转发（双保险之一，V200 检测通道）
+    [InlineData(false, true, 999UL, 100UL, true)]   // 非 edge 通道越过窗长：守卫不咬非 edge（对齐双通道 :994 else-if 语义）
+    [InlineData(true, false, 0UL, 100UL, true)]     // edge 通道无 token：全量转发（V200 12寸 inline 单 9999 零行为变化）
+    [InlineData(true, true, 0UL, 100UL, true)]      // edge 通道 + token，未达窗长：窗口内转发
+    [InlineData(true, true, 99UL, 100UL, true)]     // 边界：cur == min-1 仍在窗内
+    [InlineData(true, true, 100UL, 100UL, false)]   // 边界：cur == min 窗口已读满，截断（与双通道分支 :994 的 < 语义逐字一致）
+    [InlineData(true, true, 101UL, 100UL, false)]   // 超窗：截断（目标行为——卡 2 只采边缘窗口）
+    [InlineData(true, true, 999UL, 100UL, false)]   // 深超窗：持续截断（消除整盘 GB 级滞留）
+    public void ShouldForward_MatchesTruthTable(bool isEdgeChannel, bool hasEdgeDetectorToken,
+        ulong curTotalRead, ulong minSamplesCount, bool expected)
+    {
+        Assert.Equal(expected, EdgeForwardPolicy.ShouldForward(isEdgeChannel, hasEdgeDetectorToken, curTotalRead, minSamplesCount));
+    }
+
+    /// <summary>ToolFeaturesHelper.AllGrants 的私有 Lazy 缓存；测试经反射替换以覆盖 token 维度（照 VegaFeaturesTests 范式）。</summary>
+    private static readonly FieldInfo s_allGrantsField = typeof(ToolFeaturesHelper)
+        .GetField("s_allGrants", BindingFlags.NonPublic | BindingFlags.Static)
+        ?? throw new InvalidOperationException("ToolFeaturesHelper.s_allGrants not found.");
+
+    [Theory]
+    [InlineData(new[] { "HasEdgeDetector" }, true)]                    // 仅 Vega100-*-ED profile 授予
+    [InlineData(new[] { "HasLaserPIC", "HasEdgeDetector" }, true)]     // 与激光族正交、可并存
+    [InlineData(new[] { "Vega100", "HasLaserPIC" }, false)]            // 非 ED profile（仓库默认 Vega100-PIC）
+    [InlineData(new string[] { }, false)]                              // 无 grants（兜底）
+    public void HasEdgeDetector_FollowsGrantSpelling(string[] grants, bool expected)
+    {
+        // token 拼写四处一致（HardwareProfiles grants / ComponentConfig Condition / MachineConfig ValidOn /
+        // ToolFeaturesHelper）是红线：拼错 = 静默回退全量采集，Sim 亦观测不到，此处是唯一检出点。
+        var original = (Lazy<List<string>>?) s_allGrantsField.GetValue(null);
+        s_allGrantsField.SetValue(null, new Lazy<List<string>>(() => [.. grants]));
+        try
+        {
+            Assert.Equal(expected, ToolFeaturesHelper.HasEdgeDetector);
+        }
+        finally
+        {
+            s_allGrantsField.SetValue(null, original);
+        }
+    }
+}
