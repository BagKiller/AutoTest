+    /// <summary>
+    /// 荧光滤光片简写：FFilter1/FFilter2 显示 F1/F2，None 显示 N。
+    /// </summary>
+    internal static string FormatFluorescenceFilter(FluorescenceFilterType filter) => filter switch
+    {
+        FluorescenceFilterType.FFilter1 => "F1",
+        FluorescenceFilterType.FFilter2 => "F2",
+        _ => "N",
+    };
+
+    /// <summary>
+    /// 光学滤波器简写：按枚举名派生 ODX.Y（ODp2_5→OD2.5），无定义值显示 OD?。
+    /// </summary>
+    internal static string FormatOpticalFilter(CollectODFilterType filter)
+    {
+        // 注意：兜底不能输出裸枚举名（无定义值即裸数字），否则与相邻 PMT 电压段同形、无法分辨。
+        string name = filter.ToString();
+        if (!name.StartsWith("ODp", StringComparison.Ordinal))
+        {
+            return "OD?";
+        }
+
+        return $"OD{name[3..].Replace('_', '.')}";
+    }
+
