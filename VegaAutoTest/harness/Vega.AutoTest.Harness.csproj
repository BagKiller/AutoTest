<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>

    <IsPackable>false</IsPackable>

    <!-- 引了 xunit 只为 Assert；不标记则 dotnet test 在 sln 上会把它当测试工程，
         即使用例全过退出码仍非零，wi-verify 的"退出码 0"判据会永远不满足 -->
    <IsTestProject>false</IsTestProject>

    <!-- 试验工程自带版本，避免为了 FlaUI 去改仓库共享的 Directory.Packages.props -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- UIA 通道 -->
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />

    <!-- L1 API 通道：JSON 解析（与主程序一致用 Newtonsoft） -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- 断言与 L2 基类（Assert.Fail / IDisposable 模式） -->
    <PackageReference Include="xunit" Version="2.5.3" />
  </ItemGroup>

</Project>
