@@ -433,6 +433,63 @@ public class CircleModel
         return new CircleModel(cx, cy, radius);
     }
 
+    //Kasa algebraic least-squares circle fit: solves the same linear system as the 3-point Fit above
+    //(2*cx*x + 2*cy*y + k = x^2 + y^2, k = r^2 - cx^2 - cy^2) in a least-squares sense over all points,
+    //so the solution is unique and closed-form (no iteration, no local minima). Use it as a globally
+    //reliable seed for iterative geometric fitting (e.g. Levenberg-Marquardt).
+    //Returns null for degenerate input: fewer than 3 points, a singular normal matrix (near-collinear
+    //points) or a non-finite solution.
+    public static CircleModel? FitLeastSquares(List<(double x, double y)> points)
+    {
+        if (points.Count < 3)
+        {
+            return null;
+        }
+
+        double sx = 0.0, sy = 0.0, sxx = 0.0, syy = 0.0, sxy = 0.0;
+        double sxxx = 0.0, syyy = 0.0, sxxy = 0.0, sxyy = 0.0;
+        foreach (var (x, y) in points)
+        {
+            sx += x;
+            sy += y;
+            sxx += x * x;
+            syy += y * y;
+            sxy += x * y;
+            sxxx += x * x * x;
+            syyy += y * y * y;
+            sxxy += x * x * y;
+            sxyy += x * y * y;
+        }
+
+        var normalMatrix = Matrix<double>.Build.DenseOfArray(new double[3, 3]
+        {
+            { sxx, sxy, sx },
+            { sxy, syy, sy },
+            { sx, sy, points.Count }
+        });
+        var rhs = Vector<double>.Build.Dense([sxxx + sxyy, sxxy + syyy, sxx + syy]);
+
+        Vector<double> solution;
+        try
+        {
+            solution = normalMatrix.Solve(rhs);
+        }
+        catch (ArgumentException)
+        {
+            return null;
+        }
+
+        double cx = solution[0] / 2.0;
+        double cy = solution[1] / 2.0;
+        double rSquared = solution[2] + cx * cx + cy * cy;
+        if (!double.IsFinite(cx) || !double.IsFinite(cy) || rSquared <= 0.0)
+        {
+            return null;
+        }
+
+        return new CircleModel(cx, cy, Math.Sqrt(rSquared));
+    }
