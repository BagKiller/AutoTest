+    //径向残差 RMS：sqrt(mean((|P - C| - r)^2))，在同一量纲下比较代数解与 LM 精修解的优劣。
+    private static double RadialRms(List<(double x, double y)> points, double cx, double cy, double radius)
+    {
+        double sumOfSquares = 0.0;
+        foreach (var (x, y) in points)
+        {
+            double residual = Math.Sqrt((x - cx) * (x - cx) + (y - cy) * (y - cy)) - radius;
