@@ -0,0 +1,37 @@
+// Copyright (c) Shanghai Vega Technology Co., Ltd. All rights reserved.
+
+namespace Vega.BL.WaferAlignment.Tests;
+
+/// <summary>测试输入构造助手：列优先 2D ushort 边缘数据与 1D 数值序列，供各测试类共用。</summary>
+internal static class TestHelpers
+{
+    internal static ushort[,] MakeData(params ushort[][] columns)
+    {
+        if (columns.Length == 0)
+        {
+            throw new ArgumentException("At least one column is required.", nameof(columns));
+        }
+        var rowCount = columns[0].Length;
+        foreach (var column in columns)
+        {
+            if (column.Length != rowCount)
+            {
+                throw new ArgumentException($"All columns must have the same length. Expected {rowCount}, got {column.Length}.", nameof(columns));
+            }
+        }
+        var data = new ushort[rowCount, columns.Length];
+        for (var j = 0; j < columns.Length; j++)
+        {
+            for (var i = 0; i < columns[j].Length; i++)
+            {
+                data[i, j] = columns[j][i];
+            }
+        }
+        return data;
+    }
+
+    internal static double[] MakeY(int count, Func<int, double> y)
+    {
+        return [.. Enumerable.Range(0, count).Select(y)];
+    }
+}
