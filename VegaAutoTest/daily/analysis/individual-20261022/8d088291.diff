@@ -0,0 +1,80 @@
+// Copyright (c) Shanghai Vega Technology Co., Ltd. All rights reserved.
+
+namespace Vega.BL.WaferAlignment.Tests;
+
+/// <summary>
+/// 掩码精定位抛物线顶点回归：有效点拟合返回顶点；有效点数不足、顶点越出采样范围、
+/// 顶点两侧支撑点不足、全无效时一律返回 NaN（由上游 NaN 闸门过滤，绝不外推垃圾值）。
+/// </summary>
+public class NotchFineSearchValidTests
+{
+    [Fact]
+    public void AllValidParabola_ReturnsVertex()
+    {
+        //15 点精确抛物线 (i-7)²：拟合顶点即 7（左 7 点右 7 点，支撑充足）
+        var y = TestHelpers.MakeY(15, i => (i - 7) * (double) (i - 7));
+
+        var vertex = WaferAlignmentService.NotchFineSearchValid(y, Enumerable.Repeat(true, 15).ToArray());
+
+        Assert.Equal(7.0, vertex, 6);
+    }
+
+    [Fact]
+    public void TooFewValidPoints_ReturnsNaN()
+    {
+        //仅 5 个有效点（&lt; 2×MinSidePoints=6）：数量闸门直接拒绝
+        var y = TestHelpers.MakeY(15, i => (i - 7) * (double) (i - 7));
+        var validMask = new bool[15];
+        foreach (var i in new[] { 0, 2, 4, 6, 8 })
+        {
+            validMask[i] = true;
+        }
+
+        var vertex = WaferAlignmentService.NotchFineSearchValid(y, validMask);
+
+        Assert.True(double.IsNaN(vertex));
+    }
+
+    [Fact]
+    public void MismatchedMaskLength_ReturnsNaN()
+    {
+        //掩码长度与数据不符按失败处理（NaN），不猜测语义
+        var y = TestHelpers.MakeY(15, i => (i - 7) * (double) (i - 7));
+
+        var vertex = WaferAlignmentService.NotchFineSearchValid(y, new bool[3]);
+
+        Assert.True(double.IsNaN(vertex));
+    }
+
+    [Fact]
+    public void VertexOutOfRange_ReturnsNaN()
+    {
+        //无噪精确抛物线样本 → 拟合顶点恰为 20（>14）：先触顶点越界闸门（其先于支撑点闸门执行，拒绝路径明确）
+        var y = TestHelpers.MakeY(15, i => (i - 20) * (double) (i - 20));
+
+        var vertex = WaferAlignmentService.NotchFineSearchValid(y, Enumerable.Repeat(true, 15).ToArray());
+
+        Assert.True(double.IsNaN(vertex));
+    }
+
+    [Fact]
+    public void VertexNearEdge_InsufficientSideSupport_ReturnsNaN()
+    {
+        //顶点在 x=1：左侧仅 1 个支撑点（&lt; MinSidePoints=3），支撑闸门拒绝
+        var y = TestHelpers.MakeY(15, i => (i - 1) * (double) (i - 1));
+
+        var vertex = WaferAlignmentService.NotchFineSearchValid(y, Enumerable.Repeat(true, 15).ToArray());
+
+        Assert.True(double.IsNaN(vertex));
+    }
+
+    [Fact]
+    public void AllInvalid_ReturnsNaN()
+    {
+        var y = TestHelpers.MakeY(15, i => (i - 7) * (double) (i - 7));
+
+        var vertex = WaferAlignmentService.NotchFineSearchValid(y, new bool[15]);
+
+        Assert.True(double.IsNaN(vertex));
+    }
+}
