@@ -0,0 +1,72 @@
+// Copyright (c) Shanghai Vega Technology Co., Ltd. All rights reserved.
+
+using Vega.Data.Measurements;
+
+namespace Vega.BL.WaferAlignment.Tests;
+
+/// <summary>
+/// notch 窗口提取回归：掩码缺失/长度不符返回 null（显式失败信号）；正常窗口切片点与掩码，
+/// 并记录窗口首点的原始索引（供粗定位 trace 偏移与索引换算使用）。
+/// </summary>
+public class ExtractNotchWindowTests
+{
+    private static PointInPolar[] MakePoints(int count)
+    {
+        return [.. Enumerable.Range(0, count).Select(i => new PointInPolar(100.0 + i, (double) i / count * 2.0 * Math.PI))];
+    }
+
+    private static ValueRange<double> Window(int fromIndexInclusive, int toIndexInclusive, int count)
+    {
+        return new ValueRange<double> { Min = (double) fromIndexInclusive / count * 2.0 * Math.PI, Max = (double) toIndexInclusive / count * 2.0 * Math.PI };
+    }
+
+    [Fact]
+    public void NullMask_ReturnsNull()
+    {
+        var extracted = WaferAlignmentService.ExtractNotchWindow(MakePoints(6), null, Window(2, 4, 6));
+
+        Assert.Null(extracted);
+    }
+
+    [Fact]
+    public void MismatchedMaskLength_ReturnsNull()
+    {
+        var extracted = WaferAlignmentService.ExtractNotchWindow(MakePoints(6), new bool[5], Window(2, 4, 6));
+
+        Assert.Null(extracted);
+    }
+
+    [Fact]
+    public void WindowSlice_CopiesPointsAndMask_MapsStartIndex()
+    {
+        //窗口 [theta2, theta4]（含端点）：切片 idx2..4 共 3 点，掩码同步切片，首点原始索引 = 2
+        var points = MakePoints(6);
+        var mask = new[] { true, false, false, true, false, true };
+
+        var extracted = WaferAlignmentService.ExtractNotchWindow(points, mask, Window(2, 4, 6));
+
+        Assert.NotNull(extracted);
+        var (notchPoints, notchValidMask, windowStartIndex) = extracted.Value;
+        Assert.Equal(3, notchPoints.Length);
+        for (var k = 0; k < 3; k++)
+        {
+            Assert.Equal(102.0 + k, notchPoints[k].Radius, 6);
+            Assert.Equal((2 + k) / 6.0 * 2.0 * Math.PI, notchPoints[k].Theta, 6);
+        }
+        Assert.Equal([false, true, false], notchValidMask);
+        Assert.Equal(2, windowStartIndex);
+    }
+
+    [Fact]
+    public void EmptyWindow_ReturnsEmptyArraysWithZeroStartIndex()
+    {
+        //窗口落在采样角度之外（负角度）：空切片，WindowStartIndex 取 Math.Max(0, -1) = 0
+        var extracted = WaferAlignmentService.ExtractNotchWindow(MakePoints(6), new bool[6], new ValueRange<double> { Min = -0.1, Max = -0.05 });
+
+        Assert.NotNull(extracted);
+        var (notchPoints, notchValidMask, windowStartIndex) = extracted.Value;
+        Assert.Empty(notchPoints);
+        Assert.Empty(notchValidMask);
+        Assert.Equal(0, windowStartIndex);
+    }
+}
