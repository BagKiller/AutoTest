+// Copyright (c) Shanghai Vega Technology Co., Ltd. All rights reserved.
+
+namespace Vega.BL.WaferAlignment.Tests;
+
+/// <summary>
+/// 单列 notch 交点搜索回归：未包夹点对继续向内（缺口序列 0,100,0,0 不漏内侧真实交点）／
+/// 正常单交点按真实比例插值／相邻等强度不插值／整列无有效交点保持默认半径并标记无效
+/// （FindEdge 的 EdgeChuck 粗定位与 FindNotchEdgesForIndexes 的精定位共用此搜索）。
+/// </summary>
+public class FindBracketedNotchEdgeInColumnTests
+{
+    private const double StartRadius = 100.0;
+    private const double Pitch = 1.0;
+    private const double Threshold = 50.0;
+
+    [Fact]
+    public void GapColumn_SkipsUnbracketedPairs_AndFindsInnerCrossing()
+    {
+        //由内向外 0,100,0,0：最外 (0,0) 对未包夹须继续向内，命中内侧 (0,100) 真实交点（i=0, fraction=0.5 → i+fraction=0.5）
+        var data = TestHelpers.MakeData([0, 100, 0, 0]);
+
+        var (point, isValid) = WaferAlignmentService.FindBracketedNotchEdgeInColumn(data, 0, Threshold, StartRadius, Pitch);
+
+        Assert.True(isValid);
+        Assert.Equal(StartRadius + Pitch * 0.5, point.Radius, 6);
+        Assert.Equal(0.0, point.Theta, 6);
+    }
+
+    [Fact]
+    public void SingleCrossing_InterpolatesRealFraction()
+    {
+        //正常单交点：由内向外 0,40,100,100 → (40,100) 包夹，fraction=(50-40)/60 → i=1+1/6（非 0.5 猜测值）
+        var data = TestHelpers.MakeData([0, 40, 100, 100]);
+
+        var (point, isValid) = WaferAlignmentService.FindBracketedNotchEdgeInColumn(data, 0, Threshold, StartRadius, Pitch);
+
+        Assert.True(isValid);
+        Assert.Equal(StartRadius + Pitch * (1.0 + 1.0 / 6.0), point.Radius, 6);
+        Assert.Equal(0.0, point.Theta, 6);
+    }
+
+    [Fact]
+    public void EqualIntensities_NeverInterpolated_MarksInvalid()
+    {
+        //由内向外 100,30,30,30：i=1/i=2 两对 (30,30) 相邻等强度均须拒绝，整列无包夹交点 → 无效 + 默认半径
+        var data = TestHelpers.MakeData([100, 30, 30, 30]);
+
+        var (point, isValid) = WaferAlignmentService.FindBracketedNotchEdgeInColumn(data, 0, Threshold, StartRadius, Pitch);
+
+        Assert.False(isValid);
+        Assert.Equal(StartRadius, point.Radius, 6);
+    }
+
+    [Fact]
+    public void ValidCrossing_AtOffsetColumn_IncludesColumnFraction()
+    {
+        //4 列取 j=1 的有效交点：半径与角度均须含 jFraction=1/4 的贡献（radius = start + pitch*(i+fraction+j/N), theta = π/2）
+        var data = TestHelpers.MakeData([0, 100], [0, 100], [0, 100], [0, 100]);
+
+        var (point, isValid) = WaferAlignmentService.FindBracketedNotchEdgeInColumn(data, 1, Threshold, StartRadius, Pitch);
+
+        Assert.True(isValid);
+        Assert.Equal(StartRadius + Pitch * (0.0 + 0.5 + 0.25), point.Radius, 6);
+        Assert.Equal(0.25 * 2.0 * Math.PI, point.Theta, 6);
+    }
+
+    [Fact]
+    public void ValidCrossing_AtLastColumn_ReturnsThetaNearTwoPi()
+    {
+        //j=N-1 边界列：jFraction=(N-1)/N，theta 逼近 2π（与 j=0 拉开差距，端点几何语义不与起点混淆）
+        var data = TestHelpers.MakeData([0, 100], [0, 100], [0, 100], [0, 100]);
+
+        var (point, isValid) = WaferAlignmentService.FindBracketedNotchEdgeInColumn(data, 3, Threshold, StartRadius, Pitch);
+
+        Assert.True(isValid);
+        Assert.Equal(StartRadius + Pitch * (0.5 + 0.75), point.Radius, 6);
+        Assert.Equal(0.75 * 2.0 * Math.PI, point.Theta, 6);
+    }
+
+    [Fact]
+    public void NoBracketedCrossing_MarksInvalid_KeepsDefaultRadius()
+    {
+        //整列低于阈值（notch 缺口区整列无交点）：无效 + 默认半径/角度；j=1 同时验证列偏移
+        var data = TestHelpers.MakeData([0, 0, 0, 0], [0, 0, 0, 0]);
+
+        var (point, isValid) = WaferAlignmentService.FindBracketedNotchEdgeInColumn(data, 1, Threshold, StartRadius, Pitch);
+
+        Assert.False(isValid);
+        Assert.Equal(StartRadius + Pitch * 0.5, point.Radius, 6);
+        Assert.Equal(Math.PI, point.Theta, 6);
+    }
+
+    [Fact]
+    public void EntirelyAboveThreshold_MarksInvalid()
+    {
+        //整列不低于阈值（由外向内全程无 v[i]<threshold）：无效 + 默认半径
+        var data = TestHelpers.MakeData([100, 100, 100]);
+
+        var (point, isValid) = WaferAlignmentService.FindBracketedNotchEdgeInColumn(data, 0, Threshold, StartRadius, Pitch);
+
+        Assert.False(isValid);
+        Assert.Equal(StartRadius, point.Radius, 6);
+        Assert.Equal(0.0, point.Theta, 6);
+    }
+}
