+// Copyright (c) Shanghai Vega Technology Co., Ltd. All rights reserved.
+
+namespace Vega.BL.WaferAlignment.Tests;
+
+/// <summary>
+/// 按索引集合提取 notch 边缘点的回归：带掩码时整列搜索与掩码写入（有效=插值半径，无效/越界=默认半径）；
+/// 无掩码时保持首个低于阈值点对的原始插值/猜测行为不变。
+/// </summary>
+public class FindNotchEdgesForIndexesTests
+{
+    private const double StartRadius = 100.0;
+    private const double Pitch = 1.0;
+    private const double Threshold = 50.0;
+
+    [Fact]
+    public void Masked_MixedColumns_WriteInterpolatedRadiusAndMask()
+    {
+        //col0 正常包夹（有效，插值半径）；col1 整列无交点（无效，默认半径 + j/N 偏移）
+        var data = TestHelpers.MakeData([0, 40, 100, 100], [0, 0, 0, 0]);
+        var validMask = new bool[2];
+
+        var points = WaferAlignmentService.FindNotchEdgesForIndexes(data, [0, 1], Threshold, StartRadius, Pitch, validMask);
+
+        Assert.True(validMask[0]);
+        Assert.Equal(StartRadius + Pitch * (1.0 + 1.0 / 6.0), points[0].Radius, 6);
+        Assert.False(validMask[1]);
+        Assert.Equal(StartRadius + Pitch * 0.5, points[1].Radius, 6);
+        Assert.Equal(Math.PI, points[1].Theta, 6);
+    }
+
+    [Fact]
+    public void Masked_OutOfBoundsIndex_KeepsDefaultRadiusAndInvalid()
+    {
+        //越界索引（j=-1）：默认半径 + 掩码无效，不参与数组访问
+        var data = TestHelpers.MakeData([0, 100]);
+        var validMask = new bool[2];
+
+        var points = WaferAlignmentService.FindNotchEdgesForIndexes(data, [-1, 0], Threshold, StartRadius, Pitch, validMask);
+
+        Assert.False(validMask[0]);
+        Assert.Equal(StartRadius + Pitch * -1.0, points[0].Radius, 6);
+        Assert.True(validMask[1]);
+        Assert.Equal(StartRadius + Pitch * 0.5, points[1].Radius, 6);
+    }
+
+    [Fact]
+    public void MismatchedMaskLength_ThrowsArgumentException()
+    {
+        //掩码长度与索引数不符是契约破坏：显式抛出而非随机越界
+        var data = TestHelpers.MakeData([0, 100]);
+
+        Assert.Throws<ArgumentException>(() => WaferAlignmentService.FindNotchEdgesForIndexes(data, [0], Threshold, StartRadius, Pitch, new bool[2]));
+    }
+
+    [Fact]
+    public void Unmasked_KeepsFirstCrossingGuessBehavior()
+    {
+        //无掩码（validMask=null）保持原始行为：首个低于阈值点对 (0,0) 等强度 → 写入 i+0.5 猜测半径，不做包夹过滤
+        var data = TestHelpers.MakeData([0, 100, 0, 0]);
+
+        var points = WaferAlignmentService.FindNotchEdgesForIndexes(data, [0], Threshold, StartRadius, Pitch);
+
+        Assert.Single(points);
+        Assert.Equal(StartRadius + Pitch * 2.5, points[0].Radius, 6);
+    }
+}
