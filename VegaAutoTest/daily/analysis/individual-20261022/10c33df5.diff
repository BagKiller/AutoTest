+    /// <summary>
+    /// NewPostProc 的算法结果 JSON 顶层若携带真实 pitch（pitch_size/pitchSize，单位 um），
+    /// 则覆盖 recipe 推导的兜底值；非法值或偏离兜底值 10 倍以上时保留兜底并告警。
+    /// ReproPostProc 保留持久化的真实值，不调用本方法。
+    /// </summary>
+    private void ApplyJsonPitch(CollectionRunInfo collectionRun, JObject jObj)
+    {
+        var fallbackPitch = collectionRun.PitchInMicron;
+        var source = "recipe-fallback";
+        if (TryReadDouble(jObj, out var pitch, out var invalidKey, "pitch_size", "pitchSize"))
+        {
+            if (!double.IsFinite(pitch) || pitch <= 0)
+            {
+                _logger.Warning(_compName, $"Ignoring invalid pitch {pitch} from JSON for Collection {collectionRun.CollectionName}; keeping fallback {fallbackPitch}um.");
+            }
+            else if (fallbackPitch > 0 && (pitch < fallbackPitch / 10 || pitch > fallbackPitch * 10))
+            {
+                _logger.Warning(_compName, $"JSON pitch {pitch}um for Collection {collectionRun.CollectionName} deviates from recipe fallback {fallbackPitch}um by more than 10x; keeping fallback. Please check the algorithm JSON unit/field.");
+            }
+            else
+            {
+                collectionRun.PitchInMicron = pitch;
+                source = "json";
+            }
+        }
+        else if (invalidKey != null)
+        {
+            _logger.Warning(_compName, $"Failed to parse '{invalidKey}' as pitch for Collection {collectionRun.CollectionName}; keeping fallback {fallbackPitch}um.");
+        }
+
+        _logger.Information(_compName, $"Collection {collectionRun.CollectionName} pitch: {collectionRun.PitchInMicron}um (source: {source})");
+    }
+
+    private static bool TryReadDouble(JObject jObj, out double value, out string? invalidKey, params string[] names)
+    {
+        value = 0;
+        invalidKey = null;
+        foreach (var name in names)
+        {
+            var token = jObj[name];
+            if (token is null || token.Type is JTokenType.Null or JTokenType.Undefined)
+            {
+                continue;
+            }
+            if (token.Type is JTokenType.Float or JTokenType.Integer)
+            {
+                value = token.Value<double>();
+                return true;
+            }
+            if (double.TryParse(token.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out value))
+            {
+                return true;
+            }
+            invalidKey = name;
+            return false;
+        }
+        return false;
+    }
