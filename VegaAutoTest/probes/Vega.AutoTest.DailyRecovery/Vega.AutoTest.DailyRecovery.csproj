<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework><UseWPF>true</UseWPF>
  <IsTestProject>true</IsTestProject><PlatformTarget>x64</PlatformTarget>
  <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally><NuGetAudit>false</NuGetAudit>
  <ProductBin>$(VEGA_SW_ROOT)\Vega\bin\Debug\net8.0-windows10.0.19041.0\win-x64</ProductBin>
  <DefineConstants Condition="Exists('$(VEGA_SW_ROOT)\Vega.UI.Inspection.Tests\RecipeElementDialogCompletionTests.cs')">$(DefineConstants);HAS_DIALOG_TESTS</DefineConstants>
 </PropertyGroup>
 <ItemGroup>
  <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/><PackageReference Include="xunit" Version="2.5.3"/><PackageReference Include="xunit.runner.visualstudio" Version="2.5.3"/>
  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2"/><PackageReference Include="Castle.Core.AsyncInterceptor" Version="2.1.0"/>
  <ProjectReference Include="..\..\harness\Vega.AutoTest.Harness.csproj"/>
  <Reference Include="$(ProductBin)\Galaxy.*.dll;$(ProductBin)\Vega.*.dll;$(ProductBin)\Newtonsoft.Json.dll;$(ProductBin)\OpenCvSharp.dll;$(ProductBin)\QuadTrees.dll;$(ProductBin)\EFEM.*.dll;$(ProductBin)\Castle.Core.dll;$(ProductBin)\System.Collections.Immutable.dll;$(ProductBin)\System.Drawing.Common.dll"/>
  <Content Include="$(ProductBin)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
  <Compile Include="$(VEGA_SW_ROOT)\ComponentConfigEditor\Models\*.cs;$(VEGA_SW_ROOT)\ComponentConfigEditor\Services\HardwareProfileResolver.cs" Link="Editor\%(Filename)%(Extension)"/>
  <Compile Include="$(VEGA_SW_ROOT)\Vega.UI.Inspection.Tests\SummaryBinningEnabledTests.cs" Link="ProductTests\SummaryBinningEnabledTests.cs"/>
  <Compile Condition="Exists('$(VEGA_SW_ROOT)\Vega.UI.Inspection.Tests\RecipeElementDialogCompletionTests.cs')" Include="$(VEGA_SW_ROOT)\Vega.UI.Inspection.Tests\RecipeElementDialogCompletionTests.cs" Link="ProductTests\RecipeElementDialogCompletionTests.cs"/>
  <Compile Include="..\..\spike\Vega.AutoTest.Spike\StubLogService.cs" Link="StubLogService.cs"/>
  <Using Include="Xunit"/>
 </ItemGroup>
</Project>
